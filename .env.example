# ==============================================================================
# StreamPicker Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=False
APP_NAME=StreamPicker
APP_VERSION=1.0.0

# Database Configuration
# Local SQLite fallback: sqlite:///./streampicker.db
# Cloud PostgreSQL: postgresql://streampicker:streampicker_pass@localhost:5432/streampicker_db
DATABASE_URL=postgresql://streampicker:streampicker_pass@db:5432/streampicker_db

# Redis Caching (Optional - falls back to in-memory TTL cache if unset)
REDIS_URL=redis://redis:6379/0

# TMDB API Integration (Optional)
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Default Profile
DEFAULT_USER_ID=default_user

# Performance Tuning
CACHE_DEFAULT_TTL=300
RATE_LIMIT_RPM=180
RATE_LIMIT_BURST=60
